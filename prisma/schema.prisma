// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// Enums
// ==========================================

enum OrderStatus {
  pending_review
  quoted
  in_production
  ready_for_delivery
  completed
  cancelled

  @@map("order_status")
}

// ==========================================
// Módulo A: Catálogo y Productos
// ==========================================

model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relaciones
  products Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  name        String   @db.VarChar(150)
  slug        String   @unique @db.VarChar(150)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relaciones
  category       Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  techniques     ProductTechnique[]
  printableAreas PrintableArea[]
  variants       ProductVariant[]
  orderItems     OrderItem[]

  @@map("products")
}

model Technique {
  id             String  @id @db.VarChar(30)
  name           String  @db.VarChar(50)
  description    String? @db.Text
  requiresVector Boolean @default(false) @map("requires_vector")
  maxColors      Int?    @map("max_colors")

  // Relaciones
  products   ProductTechnique[]
  orderItems OrderItem[]

  @@map("techniques")
}

model ProductTechnique {
  productId   String @map("product_id") @db.Uuid
  techniqueId String @map("technique_id") @db.VarChar(30)

  // Relaciones
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  technique Technique @relation(fields: [techniqueId], references: [id], onDelete: Restrict)

  @@id([productId, techniqueId])
  @@map("product_techniques")
}

model PrintableArea {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  name             String   @db.VarChar(80)
  areaKey          String   @map("area_key") @db.VarChar(50)
  physicalWidthMm  Decimal  @map("physical_width_mm") @db.Decimal(8, 2)
  physicalHeightMm Decimal  @map("physical_height_mm") @db.Decimal(8, 2)
  boundingBoxJson  Json     @map("bounding_box_json")
  hasCenterSeam    Boolean  @default(false) @map("has_center_seam")
  isCurved         Boolean  @default(false) @map("is_curved")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relaciones
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("printable_areas")
}

model ProductVariant {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  colorName      String   @map("color_name") @db.VarChar(50)
  colorHex       String   @map("color_hex") @db.VarChar(7)
  sizeOrCapacity String?  @map("size_or_capacity") @db.VarChar(20)
  sku            String?  @unique @db.VarChar(100)
  mockupImageUrl String   @map("mockup_image_url") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relaciones
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@map("product_variants")
}

// ==========================================
// Módulo B: Galería Pública
// ==========================================

model ImageCategory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relaciones
  images GalleryImage[]

  @@map("image_categories")
}

model GalleryImage {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId    String?  @map("category_id") @db.Uuid
  title         String   @db.VarChar(100)
  thumbnailUrl  String   @map("thumbnail_url") @db.Text
  vectorSvgUrl  String?  @map("vector_svg_url") @db.Text
  highResPngUrl String   @map("high_res_png_url") @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relaciones
  category ImageCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@map("gallery_images")
}

// ==========================================
// Módulo C: Clientes y Pedidos
// ==========================================

model Customer {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName      String   @map("full_name") @db.VarChar(150)
  email         String   @db.VarChar(150)
  phone         String   @db.VarChar(30)
  taxId         String?  @map("tax_id") @db.VarChar(30)
  addressStreet String?  @map("address_street") @db.VarChar(255)
  city          String?  @db.VarChar(100)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relaciones
  orders Order[]

  @@map("customers")
}

model Order {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber Int         @unique @default(autoincrement()) @map("order_number")
  customerId  String      @map("customer_id") @db.Uuid
  status      OrderStatus @default(pending_review)
  notes       String?     @db.Text
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relaciones
  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items    OrderItem[]

  @@map("orders")
}

model OrderItem {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId                String   @map("order_id") @db.Uuid
  productId              String?  @map("product_id") @db.Uuid
  variantId              String?  @map("variant_id") @db.Uuid
  techniqueId            String   @map("technique_id") @db.VarChar(30)
  quantity               Int
  productNameSnapshot    String   @map("product_name_snapshot") @db.VarChar(150)
  variantDetailsSnapshot Json     @map("variant_details_snapshot")
  canvasJsonDesign       Json     @map("canvas_json_design")
  productionFilesJson    Json?    @map("production_files_json")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relaciones
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  technique Technique       @relation(fields: [techniqueId], references: [id], onDelete: Restrict)

  @@map("order_items")
}
